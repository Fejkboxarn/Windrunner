# -----------------------------
# Unity text files
# Keep these OUT of Git LFS.
# -----------------------------
*.meta text
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text
*.asset text
*.asmdef text
*.asmref text
*.shader text
*.compute text
*.cginc text
*.hlsl text
*.json text
*.xml text
*.txt text
*.cs text

# Normalize text line endings in the repository.
* text=auto

# TriForge source package: mixed-case model/image extensions and large PNG textures.
"Assets/TriForge Assets/**/*.[fF][bB][xX]" filter=lfs diff=lfs merge=lfs -text
"Assets/TriForge Assets/**/*.[tT][gG][aA]" filter=lfs diff=lfs merge=lfs -text
"Assets/TriForge Assets/**/*.[pP][nN][gG]" filter=lfs diff=lfs merge=lfs -text

# Terrain stamp R16 subassets and disposable TerrainData/history are binary Unity assets.
Assets/WindrunnerTerrain/Editor/Brushes/Library/*.asset -text
Assets/WindrunnerTerrain/Editor/Brushes/Library/Preset*.asset text
Assets/WindrunnerTerrain/Editor/Brushes/Demonstration/*.asset -text

# Locally imported Suntemple: oversized demo scenes, native terrain/lightmap data and textures.
Assets/Polyart/**/*.unity filter=lfs diff=lfs merge=lfs -text
Assets/Polyart/**/*.asset filter=lfs diff=lfs merge=lfs -text
Assets/Polyart/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
Assets/Polyart/**/*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
Assets/WindrunnerCompatibility/Suntemple/**/*.unity filter=lfs diff=lfs merge=lfs -text
Assets/WindrunnerCompatibility/Suntemple/**/*.asset filter=lfs diff=lfs merge=lfs -text
Documentation/Evidence/Suntemple/*.png filter=lfs diff=lfs merge=lfs -text
